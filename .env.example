# DualRep environment. Copy to `.env` (gitignored) and fill in; docs/SETUP.md says where each value
# comes from. Restart Metro after editing: `npm start -- --clear`.
#
# Everything named EXPO_PUBLIC_* is compiled into the app bundle and can be read by anyone who has the
# APK. Only public values belong here: the Supabase URL, the PUBLISHABLE (or legacy anon) key, and the
# PowerSync URL. NEVER put a service-role / sb_secret_ key, a database password, or any AI provider key
# (Anthropic, Gemini, ...) in this file — those live only in Supabase Edge Function secrets. The app
# refuses to start with a secret or service_role key and shows "Setup needed" instead.
#
# For EAS builds, set the same EXPO_PUBLIC_* names as EAS environment variables: the development and
# preview environments now (docs/SETUP.md, section 9), and the production environment in Phase 5 with
# the production backend's values (docs/ANDROID.md, 5.2). eas.json selects the environment per build
# profile.

# Supabase project URL: Project Settings -> Data API, e.g. https://<project-ref>.supabase.co
# Local `supabase start` from a phone or emulator: http://<your computer's LAN IP>:54321
# (plain http only works in development builds; preview/production builds need https).
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...) from Project Settings -> API Keys.
# The legacy anon key (a JWT) also works. Never the secret / service_role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PowerSync instance URL from the PowerSync dashboard, e.g. https://<instance-id>.powersync.journeyapps.com
# No trailing slash (one is trimmed if present).
EXPO_PUBLIC_POWERSYNC_URL=

# --- Build-time only (read by app.config.ts, not shipped to the app) ---

# development | preview | production (default). Normally set by the eas.json build profile; locally,
# this line sets it for `npm start` and `npm run android` (keep it at development).
APP_VARIANT=development

# EAS project id (from `eas init` / expo.dev). Only read by local `npx expo` commands: `eas` commands
# ignore .env files, so also set it as a Windows user environment variable and with `eas env:set`
# (docs/SETUP.md, section 9).
EAS_PROJECT_ID=

# Expo account or organization that owns the project. Optional.
EXPO_OWNER=
